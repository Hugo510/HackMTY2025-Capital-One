generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// Models generated to reflect the provided SQL schema (Spanish table names).
// Mantengo el generator y datasource originales.

enum AccountType {
  checking
  savings
  credit_card
}

enum CategoryType {
  ingreso
  gasto
}

enum TransactionType {
  purchase
  deposit
  withdrawal
  transfer
  bill
}

enum TransactionStatus {
  pending
  completed
  cancelled
}

enum Periodo {
  diario
  semanal
  mensual
  anual
}

enum AlertType {
  saldo_bajo
  limite_presupuesto
  pago_proximo
  transaccion_inusual
  meta_alcanzada
}

enum NotificationType {
  alerta
  informativa
  recordatorio
}

enum Priority {
  baja
  media
  alta
}

enum Result {
  exitoso
  fallido
}

model Usuario {
  id_usuario     Int                    @id @default(autoincrement())
  nombre_completo String                @db.VarChar(100)
  email          String                 @unique @db.VarChar(100)
  telefono       String?                @db.VarChar(20)
  password_hash  String                 @db.VarChar(255)
  pin_hash       String                 @db.VarChar(255)
  fecha_registro DateTime               @default(now())
  ultimo_acceso  DateTime?
  activo         Boolean                @default(true)

  preguntas Seguridad[]
  cuentas       Cuenta[]
  presupuestos  Presupuesto[]
  alertas       AlertaConfig[]
  notificaciones Notificacion[]
  sesiones      Sesion[]
  logs          LogSeguridad[]

  @@map("usuarios")
}

model Seguridad {
  id_pregunta   Int      @id @default(autoincrement())
  id_usuario    Int
  pregunta      String   @db.VarChar(200)
  respuesta_hash String  @db.VarChar(255)
  orden         Int
  fecha_creacion DateTime @default(now())

  usuario       Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@unique([id_usuario, orden], map: "unique_usuario_orden")
  @@map("preguntas_seguridad")
}

model Cuenta {
  id_cuenta           Int         @id @default(autoincrement())
  id_usuario          Int
  nessie_account_id   String?     @unique @db.VarChar(50)
  nessie_customer_id  String?     @db.VarChar(50)
  tipo_cuenta         AccountType
  nombre_cuenta       String      @db.VarChar(100)
  balance             Decimal     @default(0) @db.Decimal(15, 2)
  ultima_sincronizacion DateTime?
  fecha_creacion      DateTime    @default(now())
  activa              Boolean     @default(true)

  usuario             Usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  transacciones       Transaccion[]

  @@index([nessie_account_id], map: "idx_nessie_account")
  @@map("cuentas")
}

model Categoria {
  id_categoria    Int       @id @default(autoincrement())
  nombre_categoria String   @unique @db.VarChar(50)
  descripcion     String?   @db.VarChar(200)
  icono           String?   @db.VarChar(50)
  color           String?   @db.VarChar(7)
  tipo            CategoryType @default(gasto)
  es_sistema      Boolean   @default(false)

  transacciones   Transaccion[]
  presupuestos    Presupuesto[]

  @@map("categorias")
}

model Transaccion {
  id_transaccion     Int            @id @default(autoincrement())
  id_cuenta          Int
  id_categoria       Int?
  nessie_transaction_id String?     @unique @db.VarChar(50)
  tipo_transaccion   TransactionType
  monto              Decimal        @db.Decimal(15, 2)
  descripcion        String?
  merchant_nombre    String?        @db.VarChar(100)
  merchant_id        String?        @db.VarChar(50)
  fecha_transaccion  DateTime
  fecha_registro     DateTime       @default(now())
  estado             TransactionStatus @default(completed)

  cuenta             Cuenta         @relation(fields: [id_cuenta], references: [id_cuenta], onDelete: Cascade)
  categoria          Categoria?     @relation(fields: [id_categoria], references: [id_categoria], onDelete: SetNull)

  @@index([fecha_transaccion], map: "idx_fecha")
  @@index([id_cuenta, fecha_transaccion], map: "idx_cuenta_fecha")
  @@map("transacciones")
}

model Presupuesto {
  id_presupuesto   Int       @id @default(autoincrement())
  id_usuario       Int
  id_categoria     Int
  nombre_presupuesto String  @db.VarChar(100)
  monto_limite     Decimal   @db.Decimal(15, 2)
  monto_gastado    Decimal   @default(0) @db.Decimal(15, 2)
  periodo          Periodo   @default(mensual)
  fecha_inicio     DateTime  @db.Date
  fecha_fin        DateTime  @db.Date
  activo           Boolean   @default(true)
  fecha_creacion   DateTime  @default(now())

  usuario          Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  categoria        Categoria @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade)

  @@index([id_usuario, periodo], map: "idx_usuario_periodo")
  @@index([fecha_fin], map: "idx_fecha_fin")
  @@map("presupuestos")
}

model AlertaConfig {
  id_alerta_config Int         @id @default(autoincrement())
  id_usuario       Int
  tipo_alerta      AlertType
  activa           Boolean     @default(true)
  umbral_valor     Decimal?    @db.Decimal(15, 2)
  porcentaje_umbral Int?
  id_presupuesto   Int?
  id_cuenta        Int?
  fecha_creacion   DateTime    @default(now())

  usuario          Usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  presupuesto      Presupuesto? @relation(fields: [id_presupuesto], references: [id_presupuesto], onDelete: Cascade)
  cuenta           Cuenta?     @relation(fields: [id_cuenta], references: [id_cuenta], onDelete: Cascade)

  notificaciones   Notificacion[]

  @@map("alertas_config")
}

model Notificacion {
  id_notificacion  Int              @id @default(autoincrement())
  id_usuario       Int
  id_alerta_config Int?
  tipo_notificacion NotificationType
  titulo           String           @db.VarChar(200)
  mensaje          String
  prioridad        Priority         @default(media)
  leida            Boolean          @default(false)
  fecha_envio      DateTime         @default(now())
  fecha_lectura    DateTime?

  usuario          Usuario          @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  alerta           AlertaConfig?    @relation(fields: [id_alerta_config], references: [id_alerta_config], onDelete: SetNull)

  @@index([id_usuario, leida], map: "idx_usuario_leida")
  @@index([fecha_envio], map: "idx_fecha_envio")
  @@map("notificaciones")
}

model Sesion {
  id_sesion        Int       @id @default(autoincrement())
  id_usuario       Int
  token            String    @unique @db.VarChar(255)
  ip_address       String?   @db.VarChar(45)
  user_agent       String?
  fecha_inicio     DateTime  @default(now())
  fecha_expiracion DateTime
  activa           Boolean   @default(true)

  usuario          Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([token], map: "idx_token")
  @@index([fecha_expiracion], map: "idx_expiracion")
  @@map("sesiones")
}

model LogSeguridad {
  id_log         Int       @id @default(autoincrement())
  id_usuario     Int?
  accion         String    @db.VarChar(100)
  descripcion    String?
  ip_address     String?   @db.VarChar(45)
  resultado      Result
  fecha_accion   DateTime  @default(now())

  usuario        Usuario?  @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)

  @@index([id_usuario, fecha_accion], map: "idx_usuario_fecha")
  @@map("logs_seguridad")
}

